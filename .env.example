# ---------------------------------------------------------------------------
# Shot & Share - environment
# Copy to .env.local and fill in. Everything with a sensible dev default is
# marked "optional"; the app degrades to local drivers when they are absent.
# ---------------------------------------------------------------------------

# Public base URL. Used for share links, QR codes, the confirmation and
# password-reset links sent by email, and every canonical URL, Open Graph tag,
# sitemap entry and piece of structured data. Must be listed under Supabase
# Authentication -> URL Configuration, or those links are refused.
#
# Set this per environment and never to production on a preview: a preview that
# declares itself canonical for the live site is the fastest way to get the live
# site dropped from the index. On Vercel it falls back to the deployment's own
# production URL when unset.
#
# It has to be present at BUILD time, not only at run time. Next evaluates page
# metadata when it builds, so canonicals and Open Graph URLs are frozen into the
# output; robots.txt and sitemap.xml are rendered per request and will correct
# themselves, but the pages will not.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search consoles (optional) --------------------------------------------
# Ownership tokens, rendered as verification meta tags when present. Leave
# blank in development and on previews - verifying a preview host tells a
# search console about a site nobody should be looking at.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Guest traffic is unauthenticated, so token-validated API routes
# query with the secret key after checking the link token themselves.
SUPABASE_SECRET_KEY=

# Encrypts share tokens at rest so the dashboard can re-render a QR code
# without reissuing the link. Generate with: openssl rand -base64 32
# Required in production; development derives one from the service role key.
TOKEN_ENCRYPTION_KEY=

# --- Storage (optional in dev) ---------------------------------------------
# Leave S3_BUCKET empty to use the local filesystem driver (./.storage),
# which serves media through /api/media/* instead of a CDN.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoint (MinIO, R2). Leave blank for AWS.
S3_ENDPOINT=
# Public hostname in front of the thumbnail prefix. Keep it a SEPARATE hostname
# from the app so swapping Cloudflare -> CloudFront is a DNS change.
# e.g. https://media.shotandshare.com
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Image optimisation -----------------------------------------------------
# Set to 1 to stop routing photographs through Next's image optimiser and serve
# them straight from the bucket instead.
#
# The optimiser is metered on Vercel: one photograph at one width is one
# transformation, and past the plan's monthly ceiling /_next/image starts
# answering with an error - which on a gallery is every frame broken at once.
# Flipping this and redeploying costs nothing and keeps every picture on the
# page; thumbnails are already ~25 KB WebP cut for the tiles, so only the
# full-size copies get heavier.
#
# Leave blank normally. The app also falls back on its own if the optimiser
# starts failing mid-month - this is for turning it off before that happens.
NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=

# --- Upload moderation (optional; off unless set) ---------------------------
# Screens every photo as it arrives, before it is visible in any gallery, and
# holds anything flagged for the host. A video is screened on its poster frame.
#
# "rekognition" uses Amazon Rekognition content moderation against the object
# already in S3, so nothing leaves the bucket's region and the check is a key
# rather than an upload. It reuses S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY /
# S3_REGION, and that IAM user needs rekognition:DetectModerationLabels.
#
# Leave blank and uploads are not screened. The host's approve-before-visible
# switch and the guest report button work either way. Opt-in rather than
# inferred from the AWS keys: this costs about a tenth of a cent per photo and
# adds a few hundred milliseconds to each upload, so it should be a decision.
MODERATION_PROVIDER=

# --- Payments (optional in dev) --------------------------------------------
# Creem is the merchant of record; it handles EU VAT.
#
# The key decides which world you are in. A key starting `creem_test_` talks to
# https://test-api.creem.io and takes no money; anything else talks to
# https://api.creem.io and charges real cards. There is deliberately no second
# switch to disagree with the key.
#
# The products behind the ids below MUST be configured with tax_mode
# "inclusive" in the Creem dashboard. Every price the site shows is quoted
# inclusive of VAT, and EU consumer rules require the figure a consumer sees to
# be the figure they are charged. An exclusive product turns a published €19
# into €22.80 at checkout, which is a misleading price rather than a rounding
# difference.
#
# Without CREEM_API_KEY the app uses a local mock checkout so the upgrade flow
# can be exercised end to end in development.
CREEM_API_KEY=
# Dashboard -> Developers -> Webhook. Point the endpoint at
# <site>/api/webhooks/creem and subscribe it to at least checkout.completed,
# refund.created and dispute.created.
CREEM_WEBHOOK_SECRET=

# Product ids (prod_...), one per paid plan. NEXT_PUBLIC_ because
# src/lib/tiers.ts reads them and is imported by client components; a product id
# is already visible in every checkout URL, so there is nothing here to keep
# back.
#
# These are also what events.tier stores, so changing one after events exist
# orphans those rows - see supabase/migrations/0021.
NEXT_PUBLIC_CREEM_PRODUCT_PLUS=
NEXT_PUBLIC_CREEM_PRODUCT_PRO=
NEXT_PUBLIC_CREEM_PRODUCT_KEEP_FOREVER=
# Set to 1 to expose /api/dev/checkout, which grants a tier without paying.
# Never enable in production.
ENABLE_MOCK_CHECKOUT=1

# --- Email (optional) ------------------------------------------------------
# Without a key, retention warnings are logged to stdout instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Shot & Share <support@shotandshare.com>"

# --- Transcode worker ------------------------------------------------------
# Shared secret for /api/internal/transcode. The worker finishes the two jobs a
# browser cannot: HEIC images it could not decode, and video, which has to be
# converted to H.264 MP4 so it plays everywhere. See workers/transcode.
# Without this the endpoint rejects everything and those files stay 'pending' -
# nothing is lost, but HEIC uploads from non-Safari browsers stay unviewable
# and videos are served in whatever format they arrived in.
WORKER_SECRET=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for /api/cron/retention. Sent as `Authorization: Bearer ...`.
CRON_SECRET=
