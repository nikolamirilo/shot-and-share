{
  "Rules": [
    {
      "ID": "media-to-glacier-ir-after-30-days",
      "Status": "Enabled",
      "Filter": {},
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "GLACIER_IR"
        }
      ],
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 3
      }
    },
    {
      "ID": "expire-generated-archives",
      "Status": "Enabled",
      "Filter": {
        "Tag": {
          "Key": "kind",
          "Value": "archive"
        }
      },
      "Expiration": {
        "Days": 30
      }
    }
  ]
}
